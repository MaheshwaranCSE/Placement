FLASK_ENV=production
SECRET_KEY=replace-with-64-random-bytes-hex-string
DATABASE_URL=postgresql://placement_user:PASSWORD@postgres:5432/placement_db
REDIS_URL=redis://redis:6379/0
DB_PASSWORD=strong-random-password
ADMIN_PASSWORD=strong-admin-password

MAIL_SERVER=smtp.college.edu
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=placement@college.edu
MAIL_PASSWORD=mail-password

COLLEGE_NAME="Your College Name"

JWT_SECRET_KEY=separate-jwt-secret-64-bytes
PROMETHEUS_METRICS_PORT=9090

# Optional AWS Config for S3 Backups
BACKUP_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
